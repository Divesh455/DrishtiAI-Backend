# =========================================================
# e-Netra Backend Configuration Template
# =========================================================

# Application Info
APP_NAME=e-Netra
APP_VERSION=0.3.0
ENVIRONMENT=production
PORT=8000

# Database (Neon PostgreSQL or any standard PostgreSQL instance)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# Cloudinary (for storing and serving fundus images, heatmaps, and overlays)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API (for AI-powered patient explanations and clinical summaries)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-1.5-flash

# Optional: External Patient EHR/EMR Integration
# EXTERNAL_PATIENT_API_URL=https://api.example.com/patients/{patient_id}
# EXTERNAL_PATIENT_API_KEY=your_external_api_key

